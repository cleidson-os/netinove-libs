{
  "name": "thermal-printer-example",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@netinove/thermal-printer": "file:..",
    "expo": "~54.0.36",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "react": "19.1.0",
    "react-native": "0.81.5"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "eas:development": "eas build --profile development --platform all",
    "eas:development:ios": "eas build --profile development --platform ios",
    "eas:development:simulator": "eas build --profile development-simulator --platform ios",
    "eas:preview": "eas build --profile preview --platform all",
    "eas:preview:simulator": "eas build --profile preview-simulator --platform ios",
    "eas:production": "eas build --profile production --platform all"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "nativeModulesDir": ".."
    }
  }
