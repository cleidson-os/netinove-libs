{
  "expo": {
    "name": "thermal-printer-example",
    "slug": "thermal-printer-example",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.netinove.thermalprinter.example",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Permite buscar e conectar impressoras térmicas Bluetooth.",
        "UIBackgroundModes": ["bluetooth-central"],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.netinove.thermalprinter.example"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "fb95acb7-10b0-46d5-a6cb-371540b45e91"
      }
    },
    "owner": "netinove"
  }
}
