{
  "name": "@netinove/thermal-printer",
  "version": "1.0.0",
  "description": "Plain-text thermal printing over Android Bluetooth Classic and iOS BLE for Expo and React Native",
  "main": "build/index.js",
  "react-native": "src/index.ts",
  "types": "build/index.d.ts",
  "files": [
    "NetinoveThermalPrinter.podspec",
    "android/build.gradle",
    "android/src/main/**/*",
    "build",
    "expo-module.config.json",
    "ios/*.swift",
    "src/NetinoveThermalPrinter.types.ts",
    "src/NetinoveThermalPrinterModule.ts",
    "src/NetinoveThermalPrinterModule.web.ts",
    "src/OperationQueue.ts",
    "src/connectOptions.ts",
    "src/index.ts",
    "src/textEncoding.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node internal/module_scripts/build.js",
    "clean": "node internal/module_scripts/clean.js",
    "lint": "eslint src/",
    "test": "node internal/module_scripts/test.js",
    "prepack": "node internal/module_scripts/prepare.js",
    "open:ios": "node internal/module_scripts/open-ios.js",
    "open:android": "node internal/module_scripts/open-android.js"
  },
  "keywords": [
    "react-native",
    "bluetooth-classic",
    "bluetooth-low-energy",
    "thermal-printer",
    "expo",
    "@netinove/thermal-printer",
    "NetinoveThermalPrinter"
  ],
  "author": "Cleidson Oliveira <cleidson.oliveira@netinove.com> (https://netinove.com)",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/jest": "^29.2.1",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.12",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^15.0.3",
    "expo": "~54.0.36",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "prettier": "^3.0.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ]
  },
  "peerDependencies": {
    "expo": ">=53 <55",
    "react": ">=19.0.0 <19.2.0",
    "react-native": ">=0.79.0 <0.82.0"
  }
}
